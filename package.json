{
  "name": "deyana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "browser:extension:build": "pnpm --filter @deyana/browser-extension build",
    "browser:host:build": "cargo build --release --manifest-path apps/browser-native-host/Cargo.toml",
    "dev": "pnpm --filter @deyana/desktop dev",
    "desktop:dev": "pnpm --filter @deyana/desktop tauri dev",
    "desktop:build": "pnpm --filter @deyana/desktop tauri build",
    "release:check": "pnpm check && cargo check --manifest-path apps/browser-native-host/Cargo.toml && cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml && pnpm --filter @deyana/desktop build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "overrides": {
    "postcss": ">=8.5.18"
  }
}


